# ============================================================
# edifio Sourcing — Variables d'environnement (template)
# ============================================================
# Copier en .env.local (jamais committé). Une variable préfixée
# NEXT_PUBLIC_* est exposée au client (bundle JS). Ne JAMAIS y
# mettre de service_role key.
#
# Pour Gate 6 (étapes 1 à 4), seules les variables marquées
# [REQUIS G6] sont strictement nécessaires.

# --- App ---
# [REQUIS G6]
NEXT_PUBLIC_APP_ENV=preview                       # preview | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # local : http://localhost:3000 / preview : URL Vercel / prod : custom domain Gate 7

# --- Auth domaine (BLOQUANT Gate 6) ---
# [REQUIS G6]
ALLOWED_EMAIL_DOMAIN=alyosingenierie.fr

# --- Supabase ---
# [REQUIS G6]
# Projet "edifio-sourcing-preview" en preview/local, "-prod" en production.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
# SERVEUR UNIQUEMENT — bypass RLS — JAMAIS commité, JAMAIS exposé au client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
# Ref du projet (pour CLI Supabase / Edge Functions deploy).
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxx

# --- BDD directe (utilisée par l'ORM après spike — pooler PgBouncer Supabase) ---
# [Étape 5+]
POSTGRES_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Anthropic (Gate 6 spike + intégrations IA Gate 7+) ---
# [Étape 5+]
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# --- Emails — Resend (auth password pivot Board 2026-05-11) ---
# [REQUIS G6 — auth pivot]
# Resend envoie : (1) welcome avec password provisoire (admin → nouveau user)
# (2) password reset (flow forgot-password). Pas d'envoi via Supabase natif.
# Le domaine `alyosingenierie.fr` doit être DNS-validé côté Resend (SPF/DKIM).
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=no-reply@alyosingenierie.fr
# [Tests E2E uniquement — override endpoint pour mock local]
# RESEND_ENDPOINT_OVERRIDE=http://localhost:4000/emails

# --- Emails — Brevo (intégrations sollicitations architectes Gate 7+) ---
BREVO_API_KEY=

# --- Tests E2E (route gated /api/test/seed-session) ---
# [Optionnel — uniquement local + preview Vercel + CI]
# Poser à "1" pour activer POST /api/test/seed-session, utilisée par les helpers
# Playwright (e2e/helpers/auth.ts) pour bootstrap une session déterministe sans
# passer par le flow form-login. La route est protégée par triple-gate
# (NODE_ENV !== production OU NEXT_PUBLIC_APP_ENV !== production) ET cette
# variable. En production toute requête → 404 même si la var est posée par
# erreur. Cf. src/app/api/test/seed-session/route.ts.
E2E_TEST_ROUTES_ENABLED=

# --- Scraper Playwright Fly.io (Gate 7+) ---
SCRAPER_FLY_APP_URL=
SCRAPER_TRIGGER_SECRET=

# --- Odoo ---
# Creds par tenant dans Supabase Vault — RIEN ici.
# Chaque organisation pose ses creds dans organizations.odoo_config chiffrés Vault.
