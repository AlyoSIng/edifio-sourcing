# ============================================================
# edifio Sourcing — Variables d'environnement (template)
# ============================================================
# Copier en .env.local (jamais committé). Une variable préfixée
# NEXT_PUBLIC_* est exposée au client (bundle JS). Ne JAMAIS y
# mettre de service_role key.
#
# Pour Gate 6 (étapes 1 à 4), seules les variables marquées
# [REQUIS G6] sont strictement nécessaires.

# --- App ---
# [REQUIS G6]
NEXT_PUBLIC_APP_ENV=preview                       # preview | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # local : http://localhost:3000 / preview : URL Vercel / prod : custom domain Gate 7

# --- Auth domaine (BLOQUANT Gate 6) ---
# [REQUIS G6]
ALLOWED_EMAIL_DOMAIN=alyosingenierie.fr

# --- Supabase ---
# [REQUIS G6]
# Projet "edifio-sourcing-preview" en preview/local, "-prod" en production.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
# SERVEUR UNIQUEMENT — bypass RLS — JAMAIS commité, JAMAIS exposé au client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
# Ref du projet (pour CLI Supabase / Edge Functions deploy).
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxx

# --- BDD directe (utilisée par l'ORM après spike — pooler PgBouncer Supabase) ---
# [Étape 5+]
POSTGRES_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Drizzle ORM (Gate 6 — bootstrap tooling) ---
# [REQUIS G6 dès étape 2]
# URL lue par drizzle-kit (generate/migrate/push) ET par src/db/client.ts.
# En local + CI : connexion DIRECTE Postgres (port 5432), PAS le pooler PgBouncer
# (drizzle-kit a besoin du protocole simple pour DDL + introspection).
# En runtime Edge Function Deno : utiliser le pooler 6543 via postgres-js avec
# { prepare: false } (PgBouncer transaction mode ne supporte pas prepared statements).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Anthropic (Gate 6 spike + intégrations IA Gate 7+) ---
# [Étape 5+]
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# --- Emails — Resend (auth password pivot Board 2026-05-11) ---
# [REQUIS G6 — auth pivot]
# Resend envoie : (1) welcome avec password provisoire (admin → nouveau user)
# (2) password reset (flow forgot-password). Pas d'envoi via Supabase natif.
# Le domaine `alyosingenierie.fr` doit être DNS-validé côté Resend (SPF/DKIM).
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=no-reply@alyosingenierie.fr
# [Tests E2E uniquement — override endpoint pour mock local]
# RESEND_ENDPOINT_OVERRIDE=http://localhost:4000/emails

# --- Emails — Brevo (intégrations sollicitations architectes Gate 7+) ---
# [REQUIS Tandem étape 2]
# API key Brevo pour l'envoi transactionnel (sollicitation/relance architectes).
BREVO_API_KEY=
# IDs des 8 templates Brevo (D.1 → D.8). Posés côté Brevo, IDs collés ici.
BREVO_TEMPLATE_ID_ARCHITECT_SOLICITATION_TU=
BREVO_TEMPLATE_ID_ARCHITECT_SOLICITATION_VOUS=
BREVO_TEMPLATE_ID_ARCHITECT_FOLLOWUP_TU=
BREVO_TEMPLATE_ID_ARCHITECT_FOLLOWUP_VOUS=
BREVO_TEMPLATE_ID_ARCHITECT_DECLINE_ACKNOWLEDGMENT=
# Secret HMAC du webhook Brevo (vérification signature POST /api/webhooks/brevo).
# Brevo signe la requête en HMAC-SHA256 avec ce secret. Si Brevo impose un autre
# algo au moment de la mise en service, ajuster verifyBrevoHmac() en conséquence.
BREVO_WEBHOOK_SECRET=

# --- Architect JWT (module Tandem — page tokenisée /archi/[token]) ---
# [REQUIS Tandem étape 2]
# Paire RS256 DÉDIÉE (décision Q5 Board 2026-05-24 — pas de réutilisation des
# clés Supabase Auth). Génération : voir handoff/NOTE_260524_ARCHITECT_JWT_KEYS.md.
#
# FORMAT FIGÉ (Nadia, étape 2 Tandem 2026-05-24) :
#   - base64 mono-ligne (recommandé Vercel) — décodé au runtime via
#     Buffer.from(env, 'base64').toString('utf8'). Pas de \n échappés à gérer.
#   - PEM brut accepté en fallback (détection auto : commence par '-----BEGIN').
#   Voir src/lib/tandem/jwt.ts loadArchitectKeys() — détection format auto.
#
# RÈGLE D'OR (cf. NOTE_260524) : paire DIFFÉRENTE Prod ≠ Preview ≠ Local.
# JAMAIS la clé privée dans un chat/Slack/email. Rotation = régénérer + redéployer.
ARCHITECT_JWT_PRIVATE_KEY=
ARCHITECT_JWT_PUBLIC_KEY=

# --- Cron Vercel (sourcing quotidien) ---
# [REQUIS Gate 6 dès PR #3]
# Vercel Cron pose automatiquement `Authorization: Bearer ${CRON_SECRET}` sur
# l'appel POST /api/cron/sourcing-run. La route refuse 401 si la var n'est pas
# définie côté env Vercel (anti-route-ouverte). Génération recommandée :
#   openssl rand -hex 32
# Schedule défini dans vercel.json : `30 4 * * 1-5` UTC = 6h30 Europe/Paris en
# été (5h30 en hiver) — voir DECISIONS.md 2026-05-20 (PR #3).
CRON_SECRET=

# --- Tests E2E (route gated /api/test/seed-session) ---
# [Optionnel — uniquement local + preview Vercel + CI]
# Poser à "1" pour activer POST /api/test/seed-session, utilisée par les helpers
# Playwright (e2e/helpers/auth.ts) pour bootstrap une session déterministe sans
# passer par le flow form-login. La route est protégée par triple-gate
# (NODE_ENV !== production OU NEXT_PUBLIC_APP_ENV !== production) ET cette
# variable. En production toute requête → 404 même si la var est posée par
# erreur. Cf. src/app/api/test/seed-session/route.ts.
E2E_TEST_ROUTES_ENABLED=

# --- Scraper Playwright Fly.io (Gate 7+) ---
# Container scraper Fly.io — voir infra/playwright/README.md
SCRAPER_BASE_URL=                                 # URL du worker Fly.io (ex: https://edifio-playwright-worker.fly.dev)
SCRAPER_TRIGGER_SECRET=                           # Secret partagé scraper ↔ webhook (générer avec openssl rand -hex 32)
# Alias historique (même valeur que SCRAPER_BASE_URL) — conservé pour compatibilité
SCRAPER_FLY_APP_URL=                              # URL publique Fly (ex: https://edifio-playwright-worker.fly.dev)
# Variables suivantes : portées CONTAINER Fly.io uniquement (fly secrets set …)
# Listées ici pour traçabilité — NE JAMAIS coller leur valeur dans .env.local du Next.
# SUPABASE_URL                                    # = NEXT_PUBLIC_SUPABASE_URL côté Next
# SUPABASE_SERVICE_ROLE_KEY                       # = SUPABASE_SERVICE_ROLE_KEY ci-dessus
# WEBHOOK_TARGET_URL                              # URL de retour vers Next API (push résultats scraping)
# FLY_API_TOKEN doit rester dans .env.local du developer (jamais committé).
FLY_API_TOKEN=

# --- Odoo ---
# Phase 2 multi-tenant : creds par tenant dans Supabase Vault — RIEN ici.
# Chaque organisation pose ses creds dans organizations.odoo_config chiffrés Vault.
#
# MVP V1 mono-tenant AlyoS — variables d'env temporaires (Tandem étape 3, 2026-05-24).
# Tant que `ODOO_SYNC_ENABLED !== 'true'`, le connecteur XML-RPC reste en mode
# disabled : les opportunités sont créées en BDD (`odoo_opportunities`) avec
# `odoo_id=-1` + `last_error='sync_disabled'`, pas d'appel réseau. À activer
# uniquement quand le Vault Phase 2 est en place et que les creds sont prêtes.
ODOO_SYNC_ENABLED=
ODOO_URL=https://alyosingenierie.odoo.com/
ODOO_DB=
ODOO_USER=
# API key Odoo (Settings → Users → API Keys côté Odoo). Service account dédié.
ODOO_API_KEY=

# --- Matching V1 (Tandem) ---
# Profil de pondération du matcher architecte ↔ AO. Décision Q1 Board 2026-05-24.
# Valeurs : 'sparse_data' (défaut MVP — base à 16 % de spécialité) | 'mature'
# (à activer post-enrichissement, couverture spécialité > 60 %).
MATCHING_WEIGHTS_PROFILE=sparse_data

# --- Pappers (moulinette enrichissement fiches architectes) ---
# Clé API pappers.fr pour l'enrichissement automatique SIREN / CA / effectifs.
# Obtenir sur https://www.pappers.fr/api → "Mon compte" → "Clé API".
# Utilisée exclusivement côté serveur (Server Actions) — jamais exposée au client.
PAPPERS_API_KEY=           # Clé API pappers.fr (moulinette enrichissement architectes)
