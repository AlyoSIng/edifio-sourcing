{
  "name": "edifio-sourcing",
  "version": "0.1.0",
  "private": true,
  "description": "edifio Sourcing — outil interne AlyoS Ingénierie pour le sourcing automatique de marchés publics BTP",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rls": "pg_prove --ext .sql tests/rls/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:drizzle-only": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed/index.ts",
    "db:reset": "tsx src/db/seed/reset.ts",
    "db:fetch-boamp": "tsx src/db/seed/fetch-boamp-fixture.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "drizzle-orm": "0.39.3",
    "next": "14.2.35",
    "postgres": "3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@next/env": "^16.2.6",
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.19.40",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.5",
    "@faker-js/faker": "10.0.0",
    "drizzle-kit": "0.30.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "husky": "^9.1.7",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.19",
    "tsx": "4.22.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "zod": "4.1.13"
  }
}
