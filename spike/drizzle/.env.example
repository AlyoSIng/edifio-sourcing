# Spike Drizzle — variables d'environnement
# Copier vers .env.local (jamais committé) avant exécution.
#
# Cible bench Phase 3 : un projet Supabase EU sandbox dédié au spike Drizzle
# (ne PAS partager avec le spike Prisma — bases séparées pour éviter pollution
# d'index/statistiques, cf. plan Phase 3).
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Bench
BENCH_ITERATIONS=5
BENCH_TENDERS_COUNT=100
BENCH_ARCHITECTS_COUNT=50
