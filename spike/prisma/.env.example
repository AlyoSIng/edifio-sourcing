# Spike Prisma — variables d'environnement
# Copier vers .env.local (jamais committé) avant exécution.
#
# Cible bench Phase 3 : un projet Supabase EU sandbox dédié au spike Prisma
# (ne PAS partager avec le spike Drizzle — bases séparées pour éviter pollution
# d'index/statistiques, cf. plan Phase 3).
#
# IMPORTANT — driver-adapter : @prisma/adapter-pg consomme directement DATABASE_URL
# via pg.Pool. PAS de proxy intermédiaire. Conforme Q2 Cowork (Data Proxy NO-GO).
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Bench
BENCH_ITERATIONS=5
BENCH_TENDERS_COUNT=100
BENCH_ARCHITECTS_COUNT=50
